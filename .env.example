# น้องโชคช่วย (Nong ChokChuay) Configuration (copy to .env if you want custom settings)

# Optional override for Vault storage directory (defaults to ./data)
# OPENTHAI_DATA_DIR=./data

# Watch Folder polling interval in seconds (0 disables background polling)
# Subfolders inside data/inbox/ auto-tag files:
#   data/inbox/teacher/ -> tag "ครูอนุบาล"
#   data/inbox/me/      -> tag "ส่วนตัว"
INBOX_POLL_SECONDS=3.0

# Set to true to auto-tag, auto-categorize, and auto-extract likely receipts & student docs on upload/LINE
AUTO_EXTRACT_ON_INGEST=true

# Optional text-only LLM adapter for smarter receipt/student extraction & auto-tagging
# Raw images/PDFs are NEVER sent externally — only OCR text is sent when LLM_API_KEY (or GEMINI_API_KEY) is set.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
# Optional custom endpoint (e.g. local Ollama http://127.0.0.1:11434/v1)
LLM_BASE_URL=

# Optional LINE Official Account (LINE OA) Messaging API & Persona settings
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
ALLOWED_LINE_USER_IDS=
LINE_ALLOW_GROUP_CHATS=false
PUBLIC_BASE_URL=
TEACHER_NAME=ครูพิ้งกี้

# Authentication & Google OAuth 2.0 (fail-closed: AUTH_REQUIRED defaults to true)
APP_ENV=development
AUTH_REQUIRED=true
ALLOWED_EMAILS=cgikchik07@gmail.com,ppksaruenee@gmail.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SESSION_SECRET=
# AUTH_SESSION_TTL_SECONDS=604800
