# Local-first Solo SaaS Configuration (copy to .env if you want custom settings)

# Optional override for Vault storage directory (defaults to ./data)
# OPENTHAI_DATA_DIR=./data

# Watch Folder polling interval in seconds (0 disables background polling)
INBOX_POLL_SECONDS=3.0

# Set to true to auto-tag and auto-extract likely receipts on upload or inbox drop
AUTO_EXTRACT_ON_INGEST=false

# Optional text-only LLM adapter for smarter receipt extraction & auto-tagging
# Raw images/PDFs are NEVER sent externally — only OCR text is sent when LLM_API_KEY is set.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
# Optional custom endpoint (e.g. local Ollama http://127.0.0.1:11434/v1)
LLM_BASE_URL=
